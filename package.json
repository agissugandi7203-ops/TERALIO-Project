{
  "name": "teralio",
  "version": "1.0.0",
  "description": "Teralio - Fullstack Platform with Vite Frontend, Express Backend, Supabase & OpenAI",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --prefix frontend",
    "dev": "npm run dev:frontend",
    "install:all": "npm install",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "test": "npm run test:backend && npm run test:frontend",
    "build:frontend": "npm run build --prefix frontend",
    "seed:supabase": "node backend/scripts/seedSupabase.js"
  },
  "keywords": [
    "teralio",
    "vite",
    "react",
    "express",
    "supabase",
    "openai",
    "fullstack"
  ],
  "author": "",
  "license": "ISC"
}
