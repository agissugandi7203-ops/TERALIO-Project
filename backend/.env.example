# ==============================================================================
# TERALIO Backend Environment Variables
# Salin berkas ini menjadi `backend/.env` dan isi nilai credential yang sebenarnya.
# JANGAN PERNAH menyimpan secret key backend ini di `frontend/.env`.
# ==============================================================================

PORT=5000
NODE_ENV=development

# HTTP & Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false
HTTP_JSON_LIMIT=100kb
AI_REQUIRE_AUTH=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
REALTIME_SESSION_RATE_LIMIT_MAX=10

# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# OpenAI Credentials (Server-Only — JANGAN ekspos ke frontend)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# OpenAI Responses API & Agent Orchestration
OPENAI_TEXT_MODEL=gpt-6-astra
OPENAI_TEXT_REASONING_EFFORT=low
OPENAI_AGENT_MAX_TOOL_ROUNDS=5

# OpenAI Native Web Search
OPENAI_WEB_SEARCH_MODEL=gpt-6-astra
OPENAI_WEB_SEARCH_CONTEXT_SIZE=medium
OPENAI_WEB_SEARCH_COUNTRY=ID
OPENAI_WEB_SEARCH_CITY=Bandung
OPENAI_WEB_SEARCH_TIMEZONE=Asia/Jakarta
OPENAI_WEB_SEARCH_ALLOWED_DOMAINS=

# OpenAI Realtime Voice & WebRTC
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING_EFFORT=low
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_REALTIME_TRANSCRIPTION_LANGUAGE=id
OPENAI_REALTIME_VAD_EAGERNESS=auto
OPENAI_REALTIME_TOKEN_TTL_SECONDS=600
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=

# Model Context Protocol (MCP) Server & External Servers
MCP_SERVER_ENABLED=true
MCP_SERVER_AUTH_TOKEN=your-mcp-server-bearer-secret
TOOL_TIMEOUT_MS=20000
# JSON array opsional berisi server MCP eksternal, contoh:
# MCP_EXTERNAL_SERVERS=[{"label":"campus_data","url":"https://mcp.example.com/mcp","execution":"backend","authToken":""}]
MCP_EXTERNAL_SERVERS=

# Google Maps Platform (Server-Side Key dengan IP / API Restriction)
# Catatan: Membutuhkan Google Cloud Billing Account aktif meskipun di dalam kuota gratis bulanan.
GOOGLE_MAPS_SERVER_API_KEY=your-google-maps-server-api-key
GOOGLE_MAPS_LANGUAGE_CODE=id
GOOGLE_MAPS_REGION_CODE=ID
GOOGLE_MAPS_TIMEOUT_MS=10000
GOOGLE_MAPS_MAX_RETRIES=2
# basic (Pro SKU) | contact (Enterprise SKU) | full (Enterprise + Atmosphere SKU)
GOOGLE_MAPS_DETAILS_LEVEL=contact
