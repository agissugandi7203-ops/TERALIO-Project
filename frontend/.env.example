# Vite Frontend Environment Variables
# Variabel yang dapat diakses di browser wajib berawalan VITE_.
# PENTING: Jangan pernah menaruh OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY,
# atau GOOGLE_MAPS_SERVER_API_KEY di berkas ini.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_URL=http://localhost:5000

# Opsional: Khusus untuk merender peta interaktif Maps JavaScript API di browser.
# Wajib dibatasi dengan HTTP Referrer restriction + API restriction (Maps JavaScript API saja).
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
